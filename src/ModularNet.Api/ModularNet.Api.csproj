        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.HostingStartup" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Hosting" Version="2.3.13" />
        <PackageReference Include="Microsoft.AspNetCore.Hosting.Abstractions" Version="2.3.13" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Logging.AzureAppServices" Version="10.0.14" />
